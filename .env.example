# Local pilot only. Bind the application to localhost; use a trusted TLS proxy for remote access.
PIR_PORT=8088
PIR_DEBUG=1
PIR_DB_PASSWORD=pir-local-only
PIR_SECRET_KEY=local-development-only-pir-control
PIR_ALLOWED_HOSTS=localhost,127.0.0.1
PIR_CSRF_ORIGINS=http://localhost:8088,http://127.0.0.1:8088
